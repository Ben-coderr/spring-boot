<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.school_managment.controllers.ClassFormController">
    <top>
        <Label text="Add Class" styleClass="dialog-title" BorderPane.alignment="CENTER"/>
    </top>
    <center>
        <GridPane hgap="15" vgap="12" alignment="TOP_LEFT">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" minWidth="120"/>
                <ColumnConstraints halignment="LEFT"  hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Grade:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <ComboBox fx:id="gradeCombo" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Capacity:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Spinner fx:id="capacitySpinner" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Supervisor:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <ComboBox fx:id="supervisorCombo" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        </GridPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" BorderPane.alignment="CENTER">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <Button text="Cancel" fx:id="cancelButton"/>
            <Button text="Save" fx:id="saveButton" defaultButton="true"/>
        </HBox>
    </bottom>
</BorderPane>