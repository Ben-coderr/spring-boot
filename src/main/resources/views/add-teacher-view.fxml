<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.school_managment.controllers.TeacherFormController">
    <top>
        <Label text="Add Teacher" styleClass="dialog-title" BorderPane.alignment="CENTER"/>
    </top>
    <center>
        <ScrollPane fitToWidth="true" prefViewportHeight="500">
            <content>
                <GridPane hgap="15" vgap="12" alignment="TOP_LEFT">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="120"/>
                        <ColumnConstraints halignment="LEFT"  hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Full Name:"  GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="fullNameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Email:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="emailField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Phone:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="phoneField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Place of Birth:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="placeField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Subject:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="subjectCombo" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <Label text="Blood Type:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <ChoiceBox fx:id="bloodChoice" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                    <Label text="Sex:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <ChoiceBox fx:id="sexChoice" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                    <Label text="Birthday:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                    <DatePicker fx:id="birthdayPicker" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                    <Label text="Password:" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                    <PasswordField fx:id="passwordField" GridPane.rowIndex="8" GridPane.columnIndex="1"/>

                    <Label text="Profile Image:" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
                    <HBox spacing="5" GridPane.rowIndex="9" GridPane.columnIndex="1">
                        <TextField fx:id="imgPathField" editable="false" HBox.hgrow="ALWAYS"/>
                        <Button text="Browse" fx:id="browseButton"/>
                    </HBox>
                </GridPane>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" BorderPane.alignment="CENTER">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <Button text="Cancel" fx:id="cancelButton"/>
            <Button text="Save" fx:id="saveButton" defaultButton="true"/>
        </HBox>
    </bottom>
</BorderPane>